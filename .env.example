# =============================================================================
# SC Labs — Variables de entorno para scripts de ingest
# Copiá este archivo como .env en la raíz del proyecto
# =============================================================================

# ── Supabase ──────────────────────────────────────────────────────────────────
# Conexión directa (no pooled) — requerida para los scripts de ingest.
# Supabase → Settings → Database → Connection string → Direct connection
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres"

# Supabase URL + service role key — para operaciones que bypassean RLS
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ── scunpacked ────────────────────────────────────────────────────────────────
# Ruta local del repo scunpacked-data (StarCitizenWiki/scunpacked-data).
# Clonar con: git clone https://github.com/StarCitizenWiki/scunpacked-data ./scunpacked
SCUNPACKED_LOCAL_PATH="./scunpacked"
